{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqua-rush-online",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "83472001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "83472002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
